{
  "datasets": [
    {
      "name": "b1fe0cc3",
      "displayName": "earthquake_detail",
      "queryLines": [
        "select * from youtube_dev.silver.earthquake_data_final"
      ],
      "catalog": "youtube_dev",
      "schema": "silver"
    },
    {
      "name": "232fedfc",
      "displayName": "mag_range",
      "queryLines": [
        "select\r\n",
        "    count(*) as total_per_range, mag_range\r\n",
        "from (\r\n",
        "    select CASE\r\n",
        "        when mag < 2 then 'Micro'\r\n",
        "        when mag >= 2 and mag < 3 then 'Minor'\r\n",
        "        when mag >= 3 and mag < 4 then 'Light'\r\n",
        "        when mag >= 4 and mag < 5 then 'Moderate'        \r\n",
        "        when mag >= 5 then 'Strong'\r\n",
        "    end as mag_range\r\n",
        "    from youtube_dev.silver.earthquake_data_final\r\n",
        ") as temp\r\n",
        "group by mag_range\r\n",
        "order by total_per_range"
      ]
    },
    {
      "name": "6fbdc929",
      "displayName": "mag_by_country",
      "queryLines": [
        "select \r\n",
        "    count(*) as event_count, \r\n",
        "    country\r\n",
        "from (\r\n",
        "    select *, case\r\n",
        "        when size(split(place, ',')) = 1 then trim(split(place, ',')[0])\r\n",
        "        else trim(split(place, ',')[1])\r\n",
        "    end as country  \r\n",
        "    from youtube_dev.silver.earthquake_data_final     \r\n",
        ")\r\n",
        "group by country\r\n",
        "order by event_count desc"
      ]
    }
  ],
